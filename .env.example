# Public site URL only (canonicals, sitemap, Open Graph). Safe in the browser.
NEXT_PUBLIC_SITE_URL=https://kalvez.com

# Dashboard + generated sites (host routing). Defaults derive from SITE_URL.
# NEXT_PUBLIC_DASHBOARD_HOST=dashboard.kalvez.com
# NEXT_PUBLIC_SITES_ROOT_HOST=sites.kalvez.com

# Netlify domain automation (custom domain aliases + SSL for client launches).
# Personal access token: https://app.netlify.com/user/applications#personal-access-tokens
# Site API ID: Site configuration → General → Site details → Site ID
# NETLIFY_AUTH_TOKEN=nf_xxx
# NETLIFY_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional override for DNS instructions (defaults to kalvez.netlify.app)
# NETLIFY_DNS_TARGET=kalvez.netlify.app
# NETLIFY_SITE_NAME=kalvez

# Browser Supabase auth (dashboard). Publishable / anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails promoted to staff on login/signup.
# STAFF_EMAIL_ALLOWLIST=you@kalvez.com

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---
# Supabase (Project Settings → API). Used only via getSupabaseAdmin() on the server.
SUPABASE_URL=https://your-project.supabase.co
# Required for production server writes (leads, presence reports, blog).
# service_role key - never expose in the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional local-only fallback if service role is unset (dev). Prefer service role.
# SUPABASE_ANON_KEY=your-anon-key

# Daily blog agent (must match public.app_settings.blog_agent_token)
BLOG_AGENT_TOKEN=replace-with-long-random-token
# Used by Netlify scheduled function (netlify/functions/daily-blog) and manual curl
CRON_SECRET=replace-with-long-random-cron-secret

# Durable rate limits (required in production for multi-instance protection).
# Create a Redis database at https://upstash.com → REST API → copy URL + token.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# Cloudflare Turnstile (bot protection on public forms + report APIs).
# Create a widget at https://dash.cloudflare.com → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAA...

# Optional: richer daily articles + site copy via OpenAI
# Required for AI-generated site hero/gallery photos (recommended)
# OPENAI_API_KEY=
# OPENAI_BLOG_MODEL=gpt-4.1-mini
# OPENAI_SITE_MODEL=gpt-4.1-mini
# OPENAI_SOCIAL_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# Meta (Facebook + Instagram) social posting agent
# Create an app at https://developers.facebook.com - add Facebook Login +
# Instagram Graph API. Production posting requires App Review for the scopes.
# META_APP_ID=
# META_APP_SECRET=
# Must match a Valid OAuth Redirect URI on the Meta app (dashboard host OK):
# META_REDIRECT_URI=https://dashboard.kalvez.com/api/dashboard/social/meta/callback
# 64-char hex preferred, or any long passphrase (hashed to AES key):
# SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-or-long-passphrase

# Client invite emails (temporary password).
# Supabase Auth sends Invite via project SMTP - paste
# supabase/templates/invite.html into Auth → Email Templates → Invite user
# so {{ .Data.temporary_password }} appears in the message.
# Optional Resend copy (recommended in production):
# RESEND_API_KEY=re_xxxxxxxxx
# CLIENT_INVITE_FROM_EMAIL=Kalvez <onboarding@yourdomain.com>

# Optional: image-to-video hero clips via Gemini Veo (OpenAI Sora API is shut down)
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Digital presence report (/report) - required in production
GOOGLE_PLACES_API_KEY=
# Cap Places keyword searches per report. Default 3, max 5.
# REPORT_KEYWORD_LIMIT=3
# Optional override; defaults to GOOGLE_PLACES_API_KEY
# PAGESPEED_API_KEY=

# Optional: Google Programmable Search (Custom Search JSON API) for brand project photos.
# Create an engine at https://programmablesearchengine.google.com (Search the entire web + Image search).
# When unset, generation falls back to DuckDuckGo image search.
# GOOGLE_CSE_ID=
# Optional dedicated key; defaults to GOOGLE_PLACES_API_KEY (Custom Search API must be enabled).
# GOOGLE_CSE_API_KEY=

# Local/staging only: force demo data. Ignored in production unless both are set.
# REPORT_DEMO_MODE=1
# REPORT_DEMO_MODE_ALLOW_PROD=1

# Telegram is sent by a Supabase DB trigger on public.leads insert.
# These live in Supabase Vault (Dashboard → Database → Vault), not Next.js:
#
#   telegram_bot_token  = from @BotFather (/newbot)
#   telegram_chat_id    = your private chat id with the bot
#
# How to get chat id:
# 1. Message your bot (e.g. /start)
# 2. Open https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Copy result[].message.chat.id

# Legacy aliases still accepted by the server (prefer the names above):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
