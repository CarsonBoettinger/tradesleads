# Public site URL only (canonicals, sitemap, Open Graph). Safe in the browser.
NEXT_PUBLIC_SITE_URL=https://kalvez.com

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---
# Supabase (Project Settings → API). Used only via getSupabaseAdmin() on the server.
SUPABASE_URL=https://your-project.supabase.co
# Required for production server writes (leads, presence reports, blog).
# service_role key — never expose in the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional local-only fallback if service role is unset (dev). Prefer service role.
# SUPABASE_ANON_KEY=your-anon-key

# Daily blog agent (must match public.app_settings.blog_agent_token)
BLOG_AGENT_TOKEN=replace-with-long-random-token
# Used by Netlify scheduled function (netlify/functions/daily-blog) and manual curl
CRON_SECRET=replace-with-long-random-cron-secret

# Optional: richer daily articles via OpenAI
# OPENAI_API_KEY=
# OPENAI_BLOG_MODEL=gpt-4.1-mini

# Digital presence report (/report) - required in production
GOOGLE_PLACES_API_KEY=
# Cap Places keyword searches per report. Default 3, max 5.
# REPORT_KEYWORD_LIMIT=3
# Optional override; defaults to GOOGLE_PLACES_API_KEY
# PAGESPEED_API_KEY=

# Local/staging only: force demo data. Ignored in production unless both are set.
# REPORT_DEMO_MODE=1
# REPORT_DEMO_MODE_ALLOW_PROD=1

# Telegram is sent by a Supabase DB trigger on public.leads insert.
# These live in Supabase Vault (Dashboard → Database → Vault), not Next.js:
#
#   telegram_bot_token  = from @BotFather (/newbot)
#   telegram_chat_id    = your private chat id with the bot
#
# How to get chat id:
# 1. Message your bot (e.g. /start)
# 2. Open https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Copy result[].message.chat.id

# Legacy aliases still accepted by the server (prefer the names above):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
